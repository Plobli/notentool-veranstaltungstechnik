<!-- src/views/fachgespraech/bogen.ejs -->
<%- include('../_bereich-nav', { termin, bereiche, aktiverBereich }) %>
<h1>Fachgespräch – <%= pruefling.name %></h1>
<p class="hinweis"><a href="/pruefung/<%= termin.slug %>/fachgespraech">← zur Übersicht</a></p>
<p class="hinweis" id="autosave-status" role="status" aria-live="polite">Eingaben werden automatisch gespeichert.</p>

<div class="pruefling-nav">
  <% geschwister.forEach(g => { %>
    <a href="/pruefung/<%= termin.slug %>/fachgespraech/<%= g.id %>" class="<%= g.id === pruefling.id ? 'aktiv' : '' %>"><%= g.name %></a>
  <% }) %>
</div>

<div id="fg-form" data-pruefling="<%= pruefling.id %>" data-termin-slug="<%= termin.slug %>">

  <% kriterien.forEach(k => {
       const zeilenListe = zeilen.get(k.key) || [];
       const erg = ergebnis.kriterien.find(e => e.key === k.key); %>
    <section class="fg-bereich" data-kriterium="<%= k.key %>">
      <div class="fg-bereich-header">
        <h3>
          <span class="fg-bereich-name"><%= k.name %></span>
          <span class="fg-faktor-badge">Faktor <%= k.faktor.toLocaleString('de-DE') %></span>
          <button type="button" class="fg-info" aria-expanded="false"
            aria-label="Bewertungskriterien anzeigen">?</button>
        </h3>
        <p class="fg-beschreibung" hidden><%= k.beschreibung %></p>
      </div>

      <div class="bogen-wrap">
        <table class="bogen fg-tabelle">
          <colgroup>
            <col class="fg-col-nr">
            <col class="fg-col-thema">
            <col class="fg-col-begruendung">
            <col class="fg-col-skala">
          </colgroup>
          <thead>
            <tr>
              <th class="fg-th-nr">Nr.</th>
              <th>Thema in Stichpunkten</th>
              <th>Begründung der Punktevergabe</th>
              <th>Bewertung</th>
            </tr>
          </thead>
          <tbody class="fg-zeilen">
            <% const anzuzeigen = zeilenListe.length ? zeilenListe : [{ thema: '', begruendung: '', skala: '' }]; %>
            <% anzuzeigen.forEach((z, i) => { %>
              <tr class="fg-zeile" data-skala="<%= z.skala %>">
                <td class="fg-zeile-nr">
                  <span class="fg-nr"><%= i + 1 %></span>
                  <button type="button" class="fg-zeile-del" title="Zeile löschen" aria-label="Zeile löschen">✕</button>
                </td>
                <td class="fg-zelle"><textarea class="fg-thema" rows="1"><%= z.thema %></textarea></td>
                <td class="fg-zelle"><textarea class="fg-begruendung" rows="1"><%= z.begruendung %></textarea></td>
                <td class="fg-skala-zelle">
                  <div class="fg-skala-wahl" role="group" aria-label="Bewertung">
                    <% skala.forEach(s => { %>
                      <button type="button" class="fg-skala-btn" data-skala="<%= s.key %>"
                        title="<%= s.label %> (<%= s.wert.toLocaleString('de-DE') %>)"><%= s.symbol %></button>
                    <% }) %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="fg-bereich-ergebnis">
              <td colspan="3"><button type="button" class="fg-zeile-add">+ Zeile</button></td>
              <td class="fg-bereich-punkte<%= erg && erg.override !== null ? ' fg-override' : '' %>"
                  data-kriterium="<%= k.key %>"
                  data-errechnet="<%= erg ? erg.errechnet : 0 %>">
                <span class="fg-ergebnis-label">Ergebnis</span>
                <span class="fg-ergebnis-wert" role="button" tabindex="0"
                      title="Zum Überschreiben klicken (leeren = errechnet)"><%= erg ? erg.punkte : 0 %></span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  <% }) %>

  <table class="bogen fg-tabelle fg-gesamt-tabelle">
    <colgroup>
      <col class="fg-col-nr">
      <col class="fg-col-thema">
      <col class="fg-col-begruendung">
      <col class="fg-col-skala">
    </colgroup>
    <tbody>
      <tr class="gesamt-zeile">
        <td colspan="3" class="feld-name">Gesamtergebnis Fachgespräch (gewichtet)</td>
        <td class="fg-gesamt punkte-status <%= ergebnis.bestanden ? 'bestanden' : 'durchgefallen' %>"><%= ergebnis.gesamtpunkte %></td>
      </tr>
      <tr class="gesamt-status-zeile">
        <td colspan="3" class="feld-name">Ergebnis</td>
        <td class="gesamt-status fg-status <%= ergebnis.bestanden ? 'bestanden' : 'durchgefallen' %>">
          <span class="fg-status-text"><%= ergebnis.bestanden ? 'bestanden' : 'nicht bestanden' %></span>
          <span class="fg-note">Note: <%= ergebnis.note %></span>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<p class="hinweis fg-skala-legende">
  Bewertung je Zeile:
  <% skala.forEach(s => { %>
    <span class="fg-skala-legende-item"><strong><%= s.symbol %></strong> <%= s.label %> (<%= s.wert.toLocaleString('de-DE') %>)</span>
  <% }) %>
  · Ergebnis = Summe × 10 / Anzahl bewerteter Zeilen (max. 100)
</p>

<script src="/fachgespraech-calc.js"></script>
