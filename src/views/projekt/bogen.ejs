<!-- src/views/projekt/bogen.ejs -->
<h1>Projekt-Bewertung – <%= pruefling.name %></h1>

<form method="post" action="/projekt/<%= pruefling.id %>">
  <table>
    <thead><tr><th>Kriterium</th><th>Protokoll</th><th>Punkte (0-100)</th><th>Faktor</th></tr></thead>
    <tbody>
      <% zeilen.forEach(z => { %>
        <tr>
          <td><%= z.kriterium.name %></td>
          <td><textarea name="protokoll_<%= z.kriterium.id %>" rows="2" cols="40"><%= z.protokoll %></textarea></td>
          <td><input type="number" min="0" max="100" step="1" name="punkte_<%= z.kriterium.id %>" value="<%= z.punkte !== null ? z.punkte : '' %>"></td>
          <td><%= z.kriterium.faktor %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (ergebnis) { %>
    <p>Gesamtpunkte: <strong class="<%= ergebnis.gesamtpunkte >= 50 ? 'ok' : 'error' %>"><%= ergebnis.gesamtpunkte %></strong></p>
  <% } else { %>
    <p>Noch nicht alle Kriterien bewertet.</p>
  <% } %>

  <button type="submit" name="final" value="0">Zwischenstand speichern</button>
  <button type="submit" name="final" value="1">Als beschlossenes Ergebnis festlegen</button>
</form>
