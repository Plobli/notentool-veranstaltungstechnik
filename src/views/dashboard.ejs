<h1>Dashboard</h1>

<% if (!aktiv) { %>
  <p>Kein aktiver Prüfungstermin. <% if (user.role === 'admin') { %><a href="/admin">Jetzt anlegen</a><% } %></p>
<% } else { %>
  <h2><%= aktiv.termin.name %></h2>
  <%- include('_ergebnis-tabelle', { zeilen: aktiv.zeilen }) %>

  <% if (vergangene.length) { %>
    <section class="vergangene">
      <h2>Vergangene Prüfungen</h2>
      <% vergangene.forEach(v => { %>
        <details>
          <summary><%= v.termin.name %></summary>
          <%- include('_ergebnis-tabelle', { zeilen: v.zeilen }) %>
        </details>
      <% }) %>
    </section>
  <% } %>
<% } %>
