<%
  // Bereichswert anzeigen ("–" für null).
  function zeig(v) { return v === null || v === undefined ? '–' : v; }
  // Nur kritische Bereiche (gesetzt und < 50) rot markieren.
  function kritKlasse(v) {
    return (v !== null && v !== undefined && v < 50) ? 'zelle-krit' : '';
  }
%>
<table class="ergebnis-tabelle">
  <thead>
    <tr>
      <th>Prüfling</th>
      <th>WISO</th>
      <th>Planung</th>
      <th>Durchf.</th>
      <th>Energie ⊘</th>
      <th>Fachgespräch</th>
      <th>Gesamt (schr.)</th>
      <th>Gesamt (alles)</th>
      <th>MEp</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% zeilen.forEach(z => { %>
      <% const bestandenFinal = z.mep ? z.mep.bestanden : z.schriftlich.bestanden; %>
      <tr>
        <td><%= z.pruefling.name %></td>
        <td class="<%= kritKlasse(z.bereiche.wiso) %>"><%= zeig(z.bereiche.wiso) %></td>
        <td class="<%= kritKlasse(z.bereiche.planung) %>"><%= zeig(z.bereiche.planung) %></td>
        <td class="<%= kritKlasse(z.bereiche.durchfuehrung) %>"><%= zeig(z.bereiche.durchfuehrung) %></td>
        <td class="<%= kritKlasse(z.bereiche.energie) %>"><%= zeig(z.bereiche.energie) %></td>
        <td class="<%= kritKlasse(z.bereiche.fachgespraech) %>"><%= zeig(z.bereiche.fachgespraech) %></td>
        <td class="<%= (z.schriftlich.gesamt < 50) ? 'zelle-krit' : '' %>"><%= z.schriftlich.gesamt %></td>
        <td><%= z.gesamtAlles %></td>
        <td>
          <% if (z.mep) { %>
            <span class="<%= z.mep.bestanden ? 'ok' : 'error' %>"
                  title="<%= z.mep.teilgebiet %>: <%= z.mep.schriftlich %> + mündl. <%= z.mep.muendlich %> → <%= z.mep.bereichNachMep %>">
              <%= z.mep.bereichNachMep %> (2:1)
            </span>
          <% } else if (z.schriftlich.mepMoeglich) { %>
            <span class="mep-moeglich" title="<%= z.schriftlich.mepBereiche.join(', ') %>">möglich</span>
          <% } else { %>–<% } %>
        </td>
        <td class="status-zelle">
          <span class="status-pille <%= bestandenFinal ? 'status-ok' : 'status-fail' %>">
            <%= bestandenFinal ? 'bestanden' : 'nicht bestanden' %><%= z.mep ? ' (n. MEp)' : '' %>
          </span>
          <% if (!bestandenFinal && z.schriftlich.gruende && z.schriftlich.gruende.length) { %>
            <span class="status-grund"><%= z.schriftlich.gruende.join(' · ') %></span>
          <% } else if (!bestandenFinal && z.schriftlich.mepMoeglich && !z.mep) { %>
            <span class="status-grund">MEp könnte ausgleichen</span>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (zeilen.length === 0) { %>
      <tr><td colspan="10">Keine Prüflinge in diesem Termin.</td></tr>
    <% } %>
  </tbody>
</table>
