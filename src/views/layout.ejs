<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> – Notentool Veranstaltungstechnik</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    if (localStorage.getItem('hinweiseAus') === '1') {
      document.documentElement.classList.add('hinweise-aus');
    }
  </script>
</head>
<body>
  <header>
    <div class="header-links">
      <a href="/" class="logo">Notentool Veranstaltungstechnik</a>
      <% if (typeof termin !== 'undefined' && termin && termin.slug) { %>
        <span class="header-sep">›</span>
        <a href="/pruefung/<%= termin.slug %>" class="header-termin"><%= termin.name %></a>
      <% } %>
    </div>
    <% if (user) { %>
      <nav>
        <a href="/">Dashboard</a>
        <% if (user.role === 'admin') { %><a href="/admin">Verwaltung</a><% } %>
        <a href="/passwort"><%= user.name %></a>
        <form method="post" action="/logout" style="display:inline">
          <button type="submit">Abmelden</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main>
    <%- body %>
  </main>
  <footer>
    <p class="hinweis" id="autosave-status" role="status" aria-live="polite"></p>
    <label class="hinweise-schalter-label">
      <input type="checkbox" id="hinweise-schalter" checked>
      Erklärende Hinweistexte anzeigen
    </label>
  </footer>
  <script src="/hinweise-toggle.js"></script>
</body>
</html>
