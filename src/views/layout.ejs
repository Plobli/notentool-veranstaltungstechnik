<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> – Prüfungsverwaltung</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="header-links">
      <a href="/" class="logo">Prüfungsverwaltung</a>
      <% if (typeof termin !== 'undefined' && termin && termin.slug) { %>
        <span class="header-sep">›</span>
        <a href="/pruefung/<%= termin.slug %>" class="header-termin"><%= termin.name %></a>
      <% } %>
    </div>
    <% if (user) { %>
      <nav>
        <a href="/">Dashboard</a>
        <% if (user.role === 'admin') { %><a href="/admin">Verwaltung</a><% } %>
        <a href="/passwort"><%= user.name %></a>
        <form method="post" action="/logout" style="display:inline">
          <button type="submit">Abmelden</button>
        </form>
      </nav>
    <% } %>
  </header>
  <main>
    <%- body %>
  </main>
</body>
</html>
