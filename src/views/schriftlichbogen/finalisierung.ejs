<!-- src/views/schriftlichbogen/finalisierung.ejs -->
<%- include('../_bereich-nav', { termin, bereiche, aktiverBereich }) %>
<h1>Finalisierung – Schriftliche Prüfung</h1>

<% if (!pruefliche.length) { %>
  <p><strong><%= termin.name %></strong> hat noch keine Prüflinge.</p>
<% } else { %>
  <p class="hinweis">
    Die Einzelbewertungen aller Prüfer stehen nebeneinander. Der <strong>finale Wert</strong>
    (erste Spalte) ist das maßgebliche Ergebnis für Dashboard und §-20-Berechnung.
  </p>

  <div class="pruefling-nav">
    <% pruefliche.forEach(p => { %>
      <a href="/pruefung/<%= termin.slug %>/schriftlich/final?p=<%= p.id %>"
         class="<%= gewaehlt && p.id === gewaehlt.id ? 'aktiv' : '' %>">
        <%= p.name %><%= p.schriftlich_finalisiert ? ' ✓' : '' %>
      </a>
    <% }) %>
  </div>

  <% if (gewaehlt) { %>
    <div class="final-kopf">
      <h2><%= gewaehlt.name %></h2>
      <form method="post" action="/pruefung/<%= termin.slug %>/schriftlich/final/status">
        <input type="hidden" name="prueflingId" value="<%= gewaehlt.id %>">
        <% if (gewaehlt.schriftlich_finalisiert) { %>
          <span class="final-badge final-badge--zu">finalisiert – Einzelbögen gesperrt</span>
          <input type="hidden" name="finalisiert" value="0">
          <button type="submit" class="btn final-entsperren">Entsperren</button>
        <% } else { %>
          <input type="hidden" name="finalisiert" value="1">
          <button type="submit" class="btn btn-primary final-abschliessen">Finalisieren &amp; sperren</button>
        <% } %>
      </form>
    </div>

    <% if (!gewaehlt.schriftlich_finalisiert) { %>
      <p class="hinweis final-vorschlag-legende">
        <span class="vorschlag-muster">12</span> = vorausgefüllter Prüfer-Durchschnitt (noch nicht final).
        Anklicken bzw. bestätigen übernimmt ihn; Änderungen überschreiben ihn.
      </p>
    <% } %>

    <p class="hinweis" id="autosave-status" role="status" aria-live="polite">Änderungen am finalen Bogen werden automatisch gespeichert.</p>

    <%
      // Liest den eingetragenen Punktwert eines Bogens für ein Feld (oder null).
      function ladeFeldwert(bogen, tgKey, feld) {
        const m = bogen.roh[tgKey];
        if (!m) return null;
        const e = m.get(feld);
        return e && e.punkte !== null && e.punkte !== undefined ? e.punkte : null;
      }
      // Wiederholer: aus dem Vortermin übernommener (bestandener) Bereich?
      // Rückgabe: übernommene Punkte oder null.
      function uebernommenePunkte(tgKey) {
        return uebernommen[tgKey] !== undefined ? uebernommen[tgKey] : null;
      }
    %>
    <% if (Object.keys(uebernommen).length > 0) { %>
      <p class="hinweis">
        <strong>Wiederholer:</strong> bereits bestandene Bereiche (aus dem Vortermin) sind
        ausgegraut und mit <span class="uebernommen-badge">W</span> markiert – sie werden
        übernommen und nicht erneut finalisiert.
      </p>
    <% } %>
    <div id="final-form" data-termin-slug="<%= termin.slug %>" data-pruefling="<%= gewaehlt.id %>"
         data-feld-url="/pruefung/<%= termin.slug %>/schriftlich/final/feld">
      <% teilgebiete.forEach(tg => {
           const finalErg = boegen[0].ergebnis;
           const tgUebernommen = uebernommenePunkte(tg.key); %>
        <section class="tg-block" data-tg="<%= tg.key %>">
          <h3>
            <%= tg.name %> <span class="tg-gewicht"><%= tg.gewicht %> %</span>
            <% if (tgUebernommen !== null) { %><span class="uebernommen-badge" title="Aus dem Vortermin übernommen">übernommen · <%= tgUebernommen %> Pkt.</span><% } %>
          </h3>
          <div class="bogen-wrap">
            <table class="bogen">
              <thead>
                <tr>
                  <th class="feld-name">Aufgabe</th>
                  <% boegen.forEach(b => { %>
                    <th class="<%= b.prueferId === null ? 'final-spalte' : '' %>"><%= b.name %></th>
                  <% }) %>
                </tr>
              </thead>
              <tbody>
                <%
                  const felder = [];
                  if (tg.gebunden) felder.push('gebunden');
                  for (const f of felderMap[tg.key]) felder.push(f);
                %>
                <% felder.forEach(feld => { %>
                  <tr data-tg="<%= tg.key %>" data-feld="<%= feld %>">
                    <td class="feld-name"><%= feld === 'gebunden' ? 'Gebunden' : feld.toUpperCase() %></td>
                    <% boegen.forEach(b => { %>
                      <% if (b.prueferId === null) { %>
                        <%
                          const fe = finalDaten[tg.key].get(feld);
                          const max = feld === 'gebunden' ? tg.gebundenMax : 10;
                          const erg = finalErg.teilgebiete[tg.key];
                          // Finaler Wert gesetzt?
                          const hatFinal = fe && fe.punkte !== null && fe.punkte !== undefined;
                          // Vorschlag (Prüfer-Durchschnitt) nur für leere Felder.
                          const vorschlag = (vorschlaege[tg.key] || {})[feld];
                          // Übernommene Bereiche werden nicht finalisiert – kein
                          // Vorschlag, Feld gesperrt.
                          const feldUebernommen = tgUebernommen !== null;
                          // Bei Übernahme: Wert + Streichung stammen aus dem Vortermin-Bogen.
                          const vorFeld = feldUebernommen
                            ? ((uebernommeneFelder[tg.key] || new Map()).get(feld) || null)
                            : null;
                          const istGestrichen = feldUebernommen
                            ? Boolean(tg.streichung && vorFeld && vorFeld.gestrichen)
                            : (tg.streichung && erg.gestrichenesFeld === feld);
                          const zeigeVorschlag = !hatFinal && vorschlag !== undefined && !gewaehlt.schriftlich_finalisiert && !feldUebernommen;
                          const feldGesperrt = gewaehlt.schriftlich_finalisiert || feldUebernommen;
                          const vorWert = vorFeld && vorFeld.punkte !== null && vorFeld.punkte !== undefined ? vorFeld.punkte : '';
                        %>
                        <td class="feld-zelle final-spalte <%= istGestrichen ? 'zelle-gestrichen' : '' %> <%= feldUebernommen ? 'zelle-uebernommen' : '' %>">
                          <input type="number" step="1" min="0" max="<%= max %>"
                            class="feld-input <%= feldGesperrt ? 'gesperrt' : '' %> <%= zeigeVorschlag ? 'feld-vorschlag' : '' %>"
                            data-tg="<%= tg.key %>" data-feld="<%= feld %>"
                            data-pruefling="<%= gewaehlt.id %>"
                            <%= zeigeVorschlag ? 'data-vorschlag="1"' : '' %>
                            <%= feldGesperrt ? 'disabled' : '' %>
                            value="<%= feldUebernommen ? vorWert : (hatFinal ? fe.punkte : (zeigeVorschlag ? vorschlag : '')) %>">
                          <% if (tg.streichung) { %>
                            <label class="strich-btn <%= istGestrichen ? 'aktiv' : '' %>" title="streichen">
                              <input type="radio" name="fstrich_<%= tg.key %>" value="<%= feld %>"
                                class="strich-input" data-pruefling="<%= gewaehlt.id %>"
                                <%= istGestrichen ? 'checked' : '' %>
                                <%= feldGesperrt ? 'disabled' : '' %>>
                              <span class="strich-text">✗</span>
                            </label>
                          <% } %>
                        </td>
                      <% } else {
                           const fe = ladeFeldwert(b, tg.key, feld); %>
                        <td class="feld-zelle read-only"><%= fe === null ? '–' : fe %></td>
                      <% } %>
                    <% }) %>
                  </tr>
                <% }) %>
                <tr class="ergebnis-zeile">
                  <td class="feld-name">Punkte</td>
                  <% boegen.forEach(b => {
                       const bereich = b.ergebnis.bereiche[tg.key];
                       const finalUebernommen = b.prueferId === null && tgUebernommen !== null; %>
                    <% if (finalUebernommen) { %>
                      <td class="tg-ergebnis punkte-status uebernommen"
                          data-tg="<%= tg.key %>" data-pruefling="<%= gewaehlt.id %>"
                          title="Aus dem Vortermin übernommen – bereits bestanden, wird nicht erneut finalisiert">
                        <%= tgUebernommen %> <span class="uebernommen-badge" aria-label="Wiederholer – übernommen">W</span>
                      </td>
                    <% } else { %>
                      <td class="tg-ergebnis punkte-status <%= bereich.bestanden ? 'bestanden' : 'durchgefallen' %>"
                          <%- b.prueferId === null ? 'data-tg="'+tg.key+'" data-pruefling="'+gewaehlt.id+'"' : '' %>>
                        <%= b.ergebnis.teilgebiete[tg.key].punkte %>
                      </td>
                    <% } %>
                  <% }) %>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      <% }) %>

      <section class="tg-block">
        <table class="bogen">
          <tbody>
            <tr class="gesamt-zeile">
              <td class="feld-name">Gesamt schriftlich (gewichtet)</td>
              <% boegen.forEach(b => { %>
                <td class="gesamt-ergebnis punkte-status <%= b.ergebnis.bestanden ? 'bestanden' : 'durchgefallen' %>"
                    <%- b.prueferId === null ? 'data-pruefling="'+gewaehlt.id+'"' : '' %>>
                  <%= b.ergebnis.gesamt %>
                </td>
              <% }) %>
            </tr>
            <tr class="gesamt-status-zeile">
              <td class="feld-name">Ergebnis</td>
              <% boegen.forEach(b => {
                   let t, k;
                   if (b.ergebnis.bestanden) { t='bestanden'; k='bestanden'; }
                   else if (b.ergebnis.mepMoeglich) { t='nicht bestanden · MEp möglich'; k='mep'; }
                   else { t='nicht bestanden'; k='durchgefallen'; } %>
                <td class="gesamt-status <%= k %>" <%- b.prueferId === null ? 'data-pruefling="'+gewaehlt.id+'"' : '' %>>
                  <span class="gesamt-status-text"><%= t %></span>
                  <span class="mep-hinweis" data-pruefling="<%= gewaehlt.id %>"><%= b.ergebnis.mepMoeglich ? b.ergebnis.mepText : '' %></span>
                </td>
              <% }) %>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

    <script type="application/json" id="final-struktur"><%- JSON.stringify(struktur) %></script>
    <script src="/final-calc.js"></script>
  <% } %>
<% } %>
