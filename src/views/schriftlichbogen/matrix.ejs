<!-- src/views/schriftlichbogen/matrix.ejs -->
<%- include('../_bereich-nav', { termin, bereiche, aktiverBereich }) %>
<h1>Schriftliche Prüfung</h1>

<% if (pruefliche.length === 0) { %>
  <p><strong><%= termin.name %></strong> hat noch keine Prüflinge.
    <% if (user.role === 'admin') { %>
      <a href="/admin/termine/<%= termin.id %>">Prüflinge anlegen</a>
    <% } %>
  </p>
<% } else { %>
  <%
    // Rendert die fremden Bewertungen einer Zelle (grau, read-only), falls
    // Einsicht aktiv ist und fremde Werte vorliegen.
    function fremdZelle(prueflingId, tgKey, feld) {
      if (!fremdWerte) return '';
      const proPruefling = fremdWerte.get(prueflingId);
      if (!proPruefling || !proPruefling[tgKey] || !proPruefling[tgKey][feld]) return '';
      const eintraege = proPruefling[tgKey][feld]
        .map(e => `<span class="fremd-wert" title="${e.prueferName}">${e.punkte}</span>`)
        .join(' ');
      return `<div class="fremd-werte">${eintraege}</div>`;
    }
  %>
  <p class="hinweis"><strong><%= termin.name %></strong> · Ansicht: Matrix (alle Prüflinge nebeneinander)</p>
  <p class="eigene-bewertung-hinweis">
    Dies ist <strong>Ihre eigene Bewertung</strong> (<%= user.name %>). Jeder Prüfer bewertet für sich;
    am Ende werden die Bewertungen unter
    <a href="/pruefung/<%= termin.slug %>/schriftlich/final">Finalisierung</a> zusammengeführt.
    <% if (termin.einsicht_fremd) { %>
      <br>Die Bewertungen der anderen Prüfer sind eingeblendet (grau).
    <% } %>
  </p>
  <section class="einstellungen">
    <form method="post" action="/pruefung/<%= termin.slug %>/einstellungen/einsicht">
      <input type="hidden" name="einsicht_fremd" value="<%= termin.einsicht_fremd ? '0' : '1' %>">
      <label class="toggle-label">
        Prüfer sehen fremde Einzelbewertungen —
        <strong><%= termin.einsicht_fremd ? 'an' : 'aus' %></strong>
      </label>
      <button type="submit" class="btn btn-klein"><%= termin.einsicht_fremd ? 'Ausschalten' : 'Einschalten' %></button>
    </form>
  </section>
  <p class="hinweis" id="autosave-status" role="status" aria-live="polite">Eingaben werden automatisch gespeichert.</p>
  <p class="hinweis">
    Jeder Bereich ist ab <strong>50 Punkten</strong> bestanden (mindestens „ausreichend").
    Das Gesamt ist nach § 20 VfAusbV gewichtet.
    Die <strong>Energieversorgung</strong> ist Sperrfach – ist sie nicht bestanden, gilt die schriftliche Prüfung als nicht bestanden.
  </p>

  <div id="bogen-form" data-modus="matrix" data-termin-slug="<%= termin.slug %>">
    <div class="bogen-wrap">

      <% teilgebiete.forEach(tg => { %>
        <section class="tg-block" data-tg="<%= tg.key %>">
          <div class="tg-header">
            <h2>
              <%= tg.name %>
              <span class="tg-gewicht" title="Gewichtung innerhalb der schriftlichen Prüfung (§ 20 VfAusbV)"><%= tg.gewicht %> %</span>
              <% if (tg.sperrfach) { %><span class="tg-sperrfach" title="Sperrfach – muss mindestens ausreichend sein">Sperrfach</span><% } %>
            </h2>
            <% if (['planung','durchfuehrung','energie'].includes(tg.key)) { %>
              <form method="post" action="/pruefung/<%= termin.slug %>/schriftlich/anzahl" class="anzahl-form">
                <label class="anzahl-label">Fragen:
                  <input type="number" min="1" max="20" step="1"
                    class="anzahl-input"
                    name="anzahl_<%= tg.key %>"
                    value="<%= anzahlMap[tg.key] %>">
                </label>
                <button type="submit" class="anzahl-speichern">Speichern</button>
              </form>
            <% } %>
          </div>

          <table class="bogen">
            <colgroup>
              <col class="col-feldname">
              <% pruefliche.forEach(() => { %><col class="col-pruefling"><% }) %>
            </colgroup>
            <thead>
              <tr>
                <th class="feld-name">Aufgabe</th>
                <% pruefliche.forEach(p => { %>
                  <th><%= p.name %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
              <% if (tg.gebunden) { %>
                <tr class="gebunden" data-tg="<%= tg.key %>" data-feld="gebunden">
                  <td class="feld-name">Gebunden</td>
                  <% pruefliche.forEach(p => {
                       const e = daten.get(p.id)[tg.key].get('gebunden'); %>
                    <td class="feld-zelle">
                      <input type="number" step="1" min="0" max="<%= tg.gebundenMax %>"
                        class="feld-input" data-tg="<%= tg.key %>" data-feld="gebunden"
                        data-pruefling="<%= p.id %>"
                        name="p<%= p.id %>_<%= tg.key %>_gebunden"
                        value="<%= e && e.punkte !== null ? e.punkte : '' %>">
                      <%- fremdZelle(p.id, tg.key, 'gebunden') %>
                    </td>
                  <% }) %>
                </tr>
              <% } %>

              <% felderMap[tg.key].forEach(feld => { %>
                <tr data-tg="<%= tg.key %>" data-feld="<%= feld %>">
                  <td class="feld-name">
                    <%= feld.toUpperCase() %>
                    <% if (tg.streichung) { %>
                      <span class="hinweis">(streichbar)</span>
                    <% } %>
                  </td>
                  <% pruefliche.forEach(p => {
                       const e = daten.get(p.id)[tg.key].get(feld);
                       const erg = ergebnisse.get(p.id).teilgebiete[tg.key];
                       const istGestrichen = tg.streichung && erg.gestrichenesFeld === feld; %>
                    <td class="feld-zelle <%= istGestrichen ? 'zelle-gestrichen' : '' %>">
                      <input type="number" step="1" min="0" max="10"
                        class="feld-input" data-tg="<%= tg.key %>" data-feld="<%= feld %>"
                        data-pruefling="<%= p.id %>"
                        name="p<%= p.id %>_<%= tg.key %>_<%= feld %>"
                        value="<%= e && e.punkte !== null ? e.punkte : '' %>">
                      <% if (tg.streichung) { %>
                        <label class="strich-btn <%= istGestrichen ? 'aktiv' : '' %>" title="Diese Aufgabe streichen">
                          <input type="radio" name="strich_p<%= p.id %>_wiso"
                            value="<%= feld %>" class="strich-input"
                            data-pruefling="<%= p.id %>"
                            <%= istGestrichen ? 'checked' : '' %>>
                          <span class="strich-text" aria-label="streichen">✗</span>
                        </label>
                      <% } %>
                      <%- fremdZelle(p.id, tg.key, feld) %>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>

              <tr class="ergebnis-zeile" data-tg="<%= tg.key %>">
                <td class="feld-name">Punkte</td>
                <% pruefliche.forEach(p => {
                     const erg = ergebnisse.get(p.id);
                     const bereich = erg.bereiche[tg.key]; %>
                  <td class="tg-ergebnis punkte-status <%= bereich.bestanden ? 'bestanden' : 'durchgefallen' %>"
                    data-tg="<%= tg.key %>" data-pruefling="<%= p.id %>">
                    <%= erg.teilgebiete[tg.key].punkte %>
                  </td>
                <% }) %>
              </tr>
            </tbody>
          </table>
        </section>
      <% }) %>

      <section class="tg-block">
        <table class="bogen">
          <colgroup>
            <col class="col-feldname">
            <% pruefliche.forEach(() => { %><col class="col-pruefling"><% }) %>
          </colgroup>
          <tbody>
            <tr class="gesamt-zeile">
              <td class="feld-name">Gesamt schriftlich (gewichtet)</td>
              <% pruefliche.forEach(p => {
                   const erg = ergebnisse.get(p.id); %>
                <td class="gesamt-ergebnis punkte-status <%= erg.bestanden ? 'bestanden' : 'durchgefallen' %>"
                  data-pruefling="<%= p.id %>">
                  <%= erg.gesamt %>
                </td>
              <% }) %>
            </tr>
            <tr class="gesamt-status-zeile">
              <td class="feld-name">Ergebnis</td>
              <% pruefliche.forEach(p => {
                   const erg = ergebnisse.get(p.id);
                   let statusText, statusKlasse;
                   if (erg.bestanden) { statusText = 'bestanden'; statusKlasse = 'bestanden'; }
                   else if (erg.mepMoeglich) { statusText = 'nicht bestanden · MEP möglich'; statusKlasse = 'mep'; }
                   else { statusText = 'nicht bestanden'; statusKlasse = 'durchgefallen'; } %>
                <td class="gesamt-status <%= statusKlasse %>"
                  data-pruefling="<%= p.id %>"
                  title="MEP = mündliche Ergänzungsprüfung (§ 20 Abs. 3 VfAusbV)">
                  <span class="gesamt-status-text"><%= statusText %></span>
                  <span class="mep-hinweis" data-pruefling="<%= p.id %>"><%= erg.mepMoeglich ? erg.mepText : '' %></span>
                </td>
              <% }) %>
            </tr>
          </tbody>
        </table>
      </section>

    </div>

    <p class="hinweis">Bei WISO wird genau eine Aufgabe gestrichen (✗). Ohne Auswahl fällt automatisch U6 weg.</p>
  </div>

  <script src="/schriftlich-calc.js"></script>
<% } %>
