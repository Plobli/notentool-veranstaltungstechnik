<!-- src/views/schriftlichbogen/matrix.ejs -->
<h1>Schriftliche Prüfung</h1>

<% if (!termin) { %>
  <p>Kein aktiver Prüfungstermin.
    <% if (user.role === 'admin') { %><a href="/admin">Jetzt anlegen</a><% } %>
  </p>
<% } else if (pruefliche.length === 0) { %>
  <p><strong><%= termin.name %></strong> hat noch keine Prüflinge.
    <% if (user.role === 'admin') { %>
      <a href="/admin/termine/<%= termin.id %>">Prüflinge anlegen</a>
    <% } %>
  </p>
<% } else { %>
  <p class="hinweis"><strong><%= termin.name %></strong> · Ansicht: Matrix (alle Prüflinge nebeneinander)</p>
  <p class="hinweis" id="autosave-status" role="status" aria-live="polite">Eingaben werden automatisch gespeichert.</p>

  <div id="bogen-form" data-modus="matrix">
    <div class="bogen-wrap">
      <table class="bogen">
        <thead>
          <tr>
            <th class="feld-name">Aufgabe</th>
            <% pruefliche.forEach(p => { %>
              <th><%= p.name %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% teilgebiete.forEach((tg, tgIndex) => { %>
            <tr class="tg-zeile <%= tgIndex > 0 ? 'tg-trenner' : '' %>" data-tg="<%= tg.key %>">
              <td class="feld-name">
                <%= tg.name %>
                <% if (['planung','durchfuehrung','energie'].includes(tg.key)) { %>
                  <form method="post" action="/schriftlich/anzahl" class="anzahl-form">
                    <label class="anzahl-label">Fragen:
                      <input type="number" min="1" max="20" step="1"
                        class="anzahl-input"
                        name="anzahl_<%= tg.key %>"
                        value="<%= anzahlMap[tg.key] %>">
                    </label>
                    <button type="submit" class="anzahl-speichern">Speichern</button>
                  </form>
                <% } %>
              </td>
              <% pruefliche.forEach(p => { %><td></td><% }) %>
            </tr>

            <% if (tg.gebunden) { %>
              <tr class="gebunden" data-tg="<%= tg.key %>" data-feld="gebunden">
                <td class="feld-name">Gebunden</td>
                <% pruefliche.forEach(p => {
                     const e = daten.get(p.id)[tg.key].get('gebunden'); %>
                  <td class="feld-zelle">
                    <input type="number" step="1" min="0" max="<%= tg.gebundenMax %>"
                      class="feld-input" data-tg="<%= tg.key %>" data-feld="gebunden"
                      data-pruefling="<%= p.id %>"
                      name="p<%= p.id %>_<%= tg.key %>_gebunden"
                      value="<%= e && e.punkte !== null ? e.punkte : '' %>">
                  </td>
                <% }) %>
              </tr>
            <% } %>

            <% felderMap[tg.key].forEach(feld => { %>
              <tr data-tg="<%= tg.key %>" data-feld="<%= feld %>">
                <td class="feld-name">
                  <%= feld.toUpperCase() %>
                  <% if (tg.streichung) { %>
                    <span class="hinweis">(streichbar)</span>
                  <% } %>
                </td>
                <% pruefliche.forEach(p => {
                     const e = daten.get(p.id)[tg.key].get(feld);
                     const erg = ergebnisse.get(p.id).teilgebiete[tg.key];
                     const istGestrichen = tg.streichung && erg.gestrichenesFeld === feld; %>
                  <td class="feld-zelle <%= istGestrichen ? 'zelle-gestrichen' : '' %>">
                    <input type="number" step="1" min="0" max="10"
                      class="feld-input" data-tg="<%= tg.key %>" data-feld="<%= feld %>"
                      data-pruefling="<%= p.id %>"
                      name="p<%= p.id %>_<%= tg.key %>_<%= feld %>"
                      value="<%= e && e.punkte !== null ? e.punkte : '' %>">
                    <% if (tg.streichung) { %>
                      <label class="strich-btn <%= istGestrichen ? 'aktiv' : '' %>" title="Diese Aufgabe streichen">
                        <input type="radio" name="strich_p<%= p.id %>_wiso"
                          value="<%= feld %>" class="strich-input"
                          data-pruefling="<%= p.id %>"
                          <%= istGestrichen ? 'checked' : '' %>>
                        <span class="strich-text" aria-label="streichen">✗</span>
                      </label>
                    <% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>

            <tr class="ergebnis-zeile" data-tg="<%= tg.key %>">
              <td class="feld-name"><%= tg.name %> – Punkte</td>
              <% pruefliche.forEach(p => { %>
                <td class="tg-ergebnis" data-tg="<%= tg.key %>" data-pruefling="<%= p.id %>">
                  <%= ergebnisse.get(p.id).teilgebiete[tg.key].punkte %>
                </td>
              <% }) %>
            </tr>
          <% }) %>

          <tr class="gesamt-zeile">
            <td class="feld-name">Gesamt (Summe Teilgebiete)</td>
            <% pruefliche.forEach(p => { %>
              <td class="gesamt-ergebnis" data-pruefling="<%= p.id %>">
                <%= ergebnisse.get(p.id).gesamt %>
              </td>
            <% }) %>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="hinweis">Bei WISO wird genau eine Aufgabe gestrichen (✗). Ohne Auswahl fällt automatisch U6 weg.</p>
  </div>

  <script src="/schriftlich-calc.js"></script>
<% } %>
