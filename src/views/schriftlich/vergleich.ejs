<!-- src/views/schriftlich/vergleich.ejs -->
<h1>Vergleich: <%= fach.name %> – <%= pruefling.name %></h1>

<% if (ergebnisse.length < 2) { %>
  <p>Noch nicht genug abgeschlossene Korrekturen für einen Vergleich (<%= ergebnisse.length %> von mindestens 2).</p>
<% } else { %>
  <table>
    <thead><tr><th>Prüfer</th><th>Punkte</th></tr></thead>
    <tbody>
      <% ergebnisse.forEach(e => {
        const klasse = e.punkte > durchschnitt ? 'besser' : (e.punkte < durchschnitt ? 'schlechter' : '');
      %>
        <tr class="<%= klasse %>">
          <td><%= e.pruefer_name %></td>
          <td class="<%= e.punkte >= 50 ? 'ok' : 'error' %>"><%= e.punkte %></td>
        </tr>
      <% }) %>
      <tr>
        <td><strong>Durchschnitt</strong></td>
        <td><strong><%= durchschnitt %></strong></td>
      </tr>
    </tbody>
  </table>
<% } %>
