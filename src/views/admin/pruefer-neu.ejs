<nav class="brotkrumen">
  <a href="/">Dashboard</a> › <a href="/admin">Verwaltung</a> › Prüfer anlegen
</nav>
<h1>Prüfer anlegen</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/admin/pruefer" class="stack-form">
  <label>Name
    <input type="text" name="name" required>
  </label>
  <label>E-Mail
    <input type="email" name="email" required>
  </label>
  <label>Passwort
    <input type="password" name="password" required>
  </label>
  <label>Rolle
    <select name="role">
      <option value="pruefer">Prüfer</option>
      <option value="admin">Admin</option>
    </select>
  </label>
  <button type="submit" class="btn btn-primary">Anlegen</button>
</form>
<p class="hinweis"><a href="/admin">← zur Verwaltung</a></p>
