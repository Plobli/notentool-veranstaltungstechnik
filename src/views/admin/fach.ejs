<h1><%= fach.name %></h1>
<p><%= fach.gewichtung_prozent %>% Gewichtung<%= fach.ist_sperrfach ? ', Sperrfach' : '' %></p>

<% bloecke.forEach(block => { %>
  <h2><%= block.name %> (Ziel-Anteil: <%= block.ziel_anteil %> von 100)</h2>
  <table>
    <thead><tr><th>Code</th><th>Max-Punkte</th></tr></thead>
    <tbody>
      <% block.unteraufgaben.forEach(u => { %>
        <tr><td><%= u.code %></td><td><%= u.max_punkte %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <form method="post" action="/admin/bloecke/<%= block.id %>/unteraufgabe">
    <input type="text" name="code" placeholder="z.B. U1" required>
    <input type="number" step="0.1" name="max_punkte" placeholder="Max-Punkte" required>
    <button type="submit">Unteraufgabe hinzufügen</button>
  </form>
<% }) %>

<h2>Neuer Aufgabenblock</h2>
<form method="post" action="/admin/faecher/<%= fach.id %>/block">
  <input type="text" name="name" placeholder="z.B. Offene Aufgaben" required>
  <input type="number" step="0.1" name="ziel_anteil" placeholder="Ziel-Anteil (von 100)" required>
  <button type="submit">Block anlegen</button>
</form>
