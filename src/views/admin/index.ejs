<h1>Verwaltung</h1>

<section class="admin-block">
  <h2>Prüfungen</h2>

  <% if (!termine.length) { %>
    <p class="hinweis">Noch keine Prüfung angelegt.</p>
  <% } else { %>
    <ul class="admin-liste">
      <% termine.forEach(t => { %>
        <li class="admin-karte">
          <a class="admin-karte-titel" href="/pruefung/<%= t.slug %>"><%= t.name %></a>
          <span class="art-badge art-<%= t.art %>"><%= artLabel[t.art] || t.art %></span>
          <% if (t.ist_aktiv) { %><span class="status-aktiv">aktiv</span><% } %>
          <a href="/admin/termine/<%= t.id %>" class="admin-aktion">Prüflinge verwalten →</a>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/admin/pruefungstermine" class="pruefung-neu"
        data-vorschlag-abschluss="<%= vorschlaege.abschluss %>"
        data-vorschlag-zwischen="<%= vorschlaege.zwischen %>">
    <label>Art:
      <select name="art" id="pruefung-art">
        <option value="abschluss">Abschlussprüfung</option>
        <option value="zwischen">Zwischenprüfung</option>
      </select>
    </label>
    <label>Name:
      <input type="text" name="name" id="pruefung-name"
        value="<%= vorschlaege.abschluss %>" required>
    </label>
    <button type="submit" class="btn btn-primary">Prüfung anlegen</button>
  </form>
</section>

<script>
  (function () {
    const form = document.querySelector('.pruefung-neu');
    if (!form) return;
    const art = document.getElementById('pruefung-art');
    const name = document.getElementById('pruefung-name');
    const vorschlag = {
      abschluss: form.dataset.vorschlagAbschluss,
      zwischen: form.dataset.vorschlagZwischen,
    };
    // Merkt sich, ob der aktuelle Feldwert noch ein unveränderter Vorschlag ist.
    let istVorschlag = true;
    name.addEventListener('input', () => {
      istVorschlag = Object.values(vorschlag).includes(name.value);
    });
    art.addEventListener('change', () => {
      if (istVorschlag) name.value = vorschlag[art.value] || '';
    });
  })();
</script>

<section class="admin-block">
  <h2>Prüfer</h2>

  <% if (link) { %>
    <div class="link-box">
      <% if (link.art === 'einladung') { %>
        <p><strong>Einladungslink erstellt</strong> (Rolle: <%= link.role === 'admin' ? 'Admin' : 'Prüfer' %>, 7 Tage gültig).
          Gib ihn der einzuladenden Person weiter:</p>
      <% } else { %>
        <p><strong>Reset-Link für <%= link.name %></strong> (24 Stunden gültig). Übergib ihn der Person:</p>
      <% } %>
      <input type="text" class="link-feld" readonly value="<%= link.url %>"
             onclick="this.select()" aria-label="Link zum Kopieren">
      <p class="hinweis">Der Link wird nur jetzt angezeigt und lässt sich einmal einlösen.</p>
    </div>
  <% } %>

  <ul class="admin-liste">
    <% pruefer.forEach(p => { %>
      <li class="admin-karte">
        <span class="admin-karte-titel"><%= p.name %></span>
        <span class="pruefer-meta"><%= p.email %></span>
        <span class="rolle-badge rolle-<%= p.role %>"><%= p.role === 'admin' ? 'Admin' : 'Prüfer' %></span>
        <form method="post" action="/admin/pruefer/<%= p.id %>/reset" class="admin-inline-form">
          <button type="submit" class="btn btn-klein">Passwort-Reset-Link</button>
        </form>
      </li>
    <% }) %>
  </ul>

  <form method="post" action="/admin/einladungen" class="stamm-neu">
    <label class="inline-label">Neuer Zugang als
      <select name="role">
        <option value="pruefer">Prüfer</option>
        <option value="admin">Admin</option>
      </select>
    </label>
    <button type="submit" class="btn btn-primary">Einladungslink erstellen</button>
  </form>

  <% if (einladungen.length) { %>
    <h3 class="admin-unter">Offene Einladungen</h3>
    <ul class="admin-liste">
      <% einladungen.forEach(e => { %>
        <li class="admin-karte">
          <span class="rolle-badge rolle-<%= e.role %>"><%= e.role === 'admin' ? 'Admin' : 'Prüfer' %></span>
          <span class="pruefer-meta">erstellt <%= new Date(e.erstellt_am + 'Z').toLocaleDateString('de-DE') %>
            · läuft ab <%= new Date(e.ablauf_am + 'Z').toLocaleDateString('de-DE') %></span>
          <form method="post" action="/admin/einladungen/<%= e.id %>/loeschen" class="admin-inline-form">
            <button type="submit" class="btn btn-klein">Zurückziehen</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
