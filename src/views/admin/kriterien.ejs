<!-- src/views/admin/kriterien.ejs -->
<h1>Bewertungskriterien: <%= termin.name %></h1>
<table>
  <thead><tr><th>Kriterium</th><th>Faktor</th></tr></thead>
  <tbody>
    <% kriterien.forEach(k => { %>
      <tr><td><%= k.name %></td><td><%= k.faktor %></td></tr>
    <% }) %>
  </tbody>
</table>
<p>Summe der Faktoren sollte 1,0 ergeben (aktuell: <%= kriterien.reduce((s,k) => s + k.faktor, 0).toFixed(2) %>)</p>

<form method="post" action="/admin/termine/<%= termin.id %>/kriterien">
  <input type="text" name="name" placeholder="z.B. Anforderungen auswerten" required>
  <input type="number" step="0.01" name="faktor" placeholder="Faktor, z.B. 0.1" required>
  <button type="submit">Kriterium hinzufügen</button>
</form>

<p><em>Vorschlag entsprechend eures aktuellen Bewertungsbogens: Anforderungen auswerten (0,1), Planen und Einsetzen der Veranstaltungstechnik (0,2), Energieversorgung (0,2), Abläufe planen und abstimmen (0,1), Technische Unterlagen erstellen (0,4).</em></p>
