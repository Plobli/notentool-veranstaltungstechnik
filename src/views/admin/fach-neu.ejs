<h1>Fach anlegen</h1>
<form method="post" action="/admin/termine/<%= terminId %>/fach">
  <label>Name<br><input type="text" name="name" placeholder="z.B. WISO" required></label><br>
  <label>Gewichtung in % (Gesamtergebnis)<br><input type="number" step="0.1" name="gewichtung_prozent" required></label><br>
  <label><input type="checkbox" name="ist_sperrfach" value="1"> Sperrfach</label><br>
  <button type="submit">Anlegen</button>
</form>
