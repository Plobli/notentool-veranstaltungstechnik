<!-- src/views/admin/termin.ejs -->
<h1><%= termin.name %></h1>

<section class="admin-block">
  <h2>Prüflinge</h2>

  <% if (!pruefliche.length) { %>
    <p class="hinweis">Noch keine Prüflinge angelegt.</p>
  <% } else { %>
    <ul class="admin-liste">
      <% pruefliche.forEach(p => { %>
        <li class="admin-karte">
          <span class="admin-karte-titel"><%= p.name %></span>
          <% if (p.betrieb) { %><span class="pruefer-meta"><%= p.betrieb %></span><% } %>
          <% if (p.wiederholt_von) { %><span class="rolle-badge rolle-pruefer" title="Wiederholer aus einem Vortermin">Wiederholer</span><% } %>
          <% if (p.hatErgebnisse) { %>
            <span class="pruefer-meta admin-inline-form" title="Prüfling hat bereits Bewertungen – Löschen gesperrt">hat Bewertungen</span>
          <% } else { %>
            <form method="post" action="/admin/termine/<%= termin.id %>/pruefling/<%= p.id %>/loeschen"
                  class="admin-inline-form" onsubmit="return confirm('Prüfling <%= p.name.replace(/'/g, "\\'") %> löschen?');">
              <button type="submit" class="btn btn-klein">Löschen</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <form method="post" action="/admin/termine/<%= termin.id %>/pruefling" class="stamm-neu">
    <input type="text" name="name" placeholder="Name" required>
    <input type="text" name="betrieb" placeholder="Betrieb (optional)">
    <button type="submit" class="btn btn-primary">Prüfling hinzufügen</button>
  </form>

  <% if (termin.art === 'abschluss') { %>
    <p class="hinweis" style="margin-top:0.75rem">
      <a class="btn btn-klein" href="/admin/termine/<%= termin.id %>/import">Wiederholer aus Vortermin importieren</a>
    </p>
  <% } %>
</section>

<p class="hinweis"><a href="/pruefung/<%= termin.slug %>">← zur Prüfungs-Übersicht</a></p>
