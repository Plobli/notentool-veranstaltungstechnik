<h1><%= termin.name %> <span class="art-badge art-<%= termin.art %>"><%= artLabel %></span></h1>

<% if (user.role === 'admin') { %>
  <p class="hinweis"><a href="/admin/termine/<%= termin.id %>">Prüflinge &amp; Stammdaten verwalten</a></p>
<% } %>

<section class="bereich-links">
  <% bereiche.forEach(b => { %>
    <a class="bereich-karte<%= b.fertig ? '' : ' bereich-karte--offen' %><%= b.unterpunkt ? ' bereich-karte--unter' : '' %>"
       href="/pruefung/<%= termin.slug %>/<%= b.pfad || b.slug %>">
      <span class="bereich-karte-name"><%= b.name %></span>
      <% if (!b.fertig) { %>
        <span class="bereich-karte-hinweis">in Vorbereitung</span>
      <% } else if (b.hinweis) { %>
        <span class="bereich-karte-hinweis"><%= b.hinweis %></span>
      <% } %>
    </a>
  <% }) %>
</section>

<h2>Ergebnisübersicht</h2>
<%- include('../_ergebnis-tabelle', { zeilen }) %>
